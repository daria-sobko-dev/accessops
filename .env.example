# Copy this file to .env and fill in the values.
# .env is ignored by git; never commit real secrets.

# --- Postgres ---
# Database user for the AccessOps app.
POSTGRES_USER=
# Strong random password, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(24))"`
POSTGRES_PASSWORD=
# Database name.
POSTGRES_DB=
# Host port for Postgres (5433, because 5432 is used by another project).
POSTGRES_PORT=

# --- RabbitMQ ---
# Login for the management UI (http://localhost:15672) and AMQP clients.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- n8n ---
# Key n8n uses to encrypt stored credentials. Do not change it after first start,
# or n8n will not be able to decrypt saved credentials.
N8N_ENCRYPTION_KEY=
# Host port for the n8n UI.
N8N_PORT=
# Timezone for n8n schedules (also used as TZ), e.g. Europe/Madrid.
GENERIC_TIMEZONE=

# --- linux-target (Ansible) ---
# Public key of the Ansible service account. Not a secret, but generated per machine:
# do not fill in by hand, run `python -m accessops ssh-bootstrap`.
ANSIBLE_AUTHORIZED_KEY=

# --- accessops-api (called by n8n inside the compose network) ---
# Both are written by `python -m accessops api-bootstrap`; do not fill in by hand.
# Token n8n sends as "Authorization: Bearer ...".
ACCESSOPS_API_TOKEN=
# Ansible private key as one base64 line; compose passes it to accessops-api as a secret.
ANSIBLE_SSH_PRIVATE_KEY_B64=

# --- Telegram alerts ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your chat with the bot: write to the bot, then run `python -m accessops telegram-setup`.
TELEGRAM_CHAT_ID=
